# ============================================================================
# dsh-secretary.service — die Sekretaerin als Dauerlaeufer.
#
# Installieren:
#   cp services/secretary/dsh-secretary.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now dsh-secretary
#
# Log:  journalctl --user -u dsh-secretary -f
# Stop: systemctl --user stop dsh-secretary
#
# Das DB-Passwort steht in KEINER Datei: env.sh liest es zur Laufzeit aus dem
# openbrain-db-Container. Deshalb der Umweg ueber bash -c.
# ============================================================================
[Unit]
Description=DSH Workitem-Sekretaerin (arbeitet den Workitem-Graphen ab)
Documentation=file:/home/daniel/QJM/services/secretary/README.md

[Service]
Type=simple
WorkingDirectory=/home/daniel/QJM/services/secretary
Environment=PYTHONUNBUFFERED=1
Environment=SECRETARY_TICK_SECONDS=2

ExecStart=/bin/bash -c 'source /home/daniel/QJM/services/secretary/env.sh && exec /home/daniel/QJM/services/secretary/.venv/bin/python -m secretary.cli run'

# Immer laufen. Ein Absturz ist kein Grund, den Graphen liegen zu lassen —
# laufende Items erholt der Lease-Ablauf beim naechsten Start.
Restart=always
RestartSec=5

# Beim Stop laufende Auftraege noch zu Ende bringen, aber nicht ewig.
TimeoutStopSec=60

# Beim Beenden auch die dsh-Subprozesse mitnehmen (control-group, Standard).
KillMode=control-group

[Install]
WantedBy=default.target
