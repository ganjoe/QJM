# === NVIDIA NeMo Switchyard & Gateway Configuration ===
SWITCHYARD_PORT=4000
SWITCHYARD_HOST=0.0.0.0

# === LM Studio & vLLM Model Configuration ===
LM_STUDIO_MODELS_DIR=/home/daniel/.lmstudio/models
LMSTUDIO_HOST_DIR=/home/daniel/.lmstudio
LMSTUDIO_API_PORT=1234
LMSTUDIO_WEB_PORT=3002
LMSTUDIO_URL=http://host.docker.internal:1234

# Optional: vLLM (ROCm)
VLLM_MODEL=bartowski/Qwen2.5-Coder-32B-Instruct-GGUF:Q4_K_M
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEM_UTIL=0.85

# === API Keys ===
GEMINI_API_KEY=your-gemini-api-key

# === Netzwerk-Backends (statische IPs, optional) ===
OLLAMA_RX6700_URL=http://192.168.x.x:11434
OLLAMA_MACBOOK_URL=http://192.168.x.x:11434

# === OpenBrain MCP Configuration ===
MCP_ACCESS_KEY=
OPENBRAIN_CCO_MCP_URL=http://host.docker.internal:8788
